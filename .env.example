
# ==========================================
# ProjectPulse Environment Configuration Example
# ==========================================
# Copy this file to .env and configure your own values.
# Never commit real production secrets, passwords, or keys.

# --- Backend Application Configuration ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Database Configuration (MySQL 8.x) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=projectpulse_db
DB_USER=root
DB_PASSWORD=CHANGE_THIS_BEFORE_RUNNING
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- JWT Authentication Security ---
# Replace with your own secure random secret (at least 32 bytes).
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Default Platform Admin Bootstrap ---
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_THIS_BEFORE_RUNNING
ADMIN_INITIAL_NAME=System Administrator

# --- Desktop Tracking Agent Configuration ---
AGENT_SERVER_URL=http://localhost:8080
AGENT_DEVICE_NAME=Dev-Workstation-01
AGENT_BATCH_INTERVAL_MS=3000
AGENT_MAX_BATCH_SIZE=50
AGENT_RETRY_INTERVAL_SECONDS=10

# --- Hyperledger Fabric Configuration ---
FABRIC_ENABLED=false
FABRIC_NETWORK_CONFIG_PATH=blockchain-network/connection-org1.json
FABRIC_CERT_PATH=blockchain-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=blockchain-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/priv_sk
FABRIC_CHANNEL_NAME=projectpulse-channel
FABRIC_CHAINCODE_NAME=activitytracker
FABRIC_MSP_ID=Org1MSP

# --- Frontend Application Configuration ---
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_TITLE=ProjectPulse
VITE_ENABLE_BLOCKCHAIN_VERIFICATION=true
