{
  "info": {
    "name": "ProjectPulse API Collection",
    "description": "Comprehensive Postman collection for ProjectPulse backend REST APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "orgId",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Developer\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123!\",\n  \"organizationName\": \"Engineering Lab\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "List Organizations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/organizations", "host": ["{{baseUrl}}"], "path": ["organizations"] }
          }
        },
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Research Org\",\n  \"slug\": \"research-org\",\n  \"description\": \"Distributed systems research\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/organizations", "host": ["{{baseUrl}}"], "path": ["organizations"] }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/organizations/{{orgId}}/projects", "host": ["{{baseUrl}}"], "path": ["organizations", "{{orgId}}", "projects"] }
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Blockchain Tracking\",\n  \"keyIdentifier\": \"BTRACK\",\n  \"description\": \"Core ledger anchoring project\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/organizations/{{orgId}}/projects", "host": ["{{baseUrl}}"], "path": ["organizations", "{{orgId}}", "projects"] }
          }
        }
      ]
    },
    {
      "name": "Activities",
      "item": [
        {
          "name": "Batch Ingestion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"deviceId\": \"test-device-uuid\",\n  \"events\": [\n    {\n      \"clientAssignedUuid\": \"evt-001\",\n      \"eventType\": \"FILE_MODIFY\",\n      \"filePath\": \"src/main/App.java\",\n      \"eventCount\": 1,\n      \"timestamp\": \"2026-11-02T15:30:00Z\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/activities/batch", "host": ["{{baseUrl}}"], "path": ["activities", "batch"] }
          }
        }
      ]
    },
    {
      "name": "Blockchain",
      "item": [
        {
          "name": "Verify Activity",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/blockchain/verify/sample-activity-id", "host": ["{{baseUrl}}"], "path": ["blockchain", "verify", "sample-activity-id"] }
          }
        }
      ]
    }
  ]
}
